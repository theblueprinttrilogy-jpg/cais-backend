					<style>
.abnt-campanhas-section{
  width:100%;
  padding:72px 24px;
  background:#f5f7fa;
  font-family:Inter,Arial,sans-serif;
}

.abnt-campanhas-wrap{
  max-width:1280px;
  margin:0 auto;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:34px;
}

/* CARDS */
.abnt-campanha-card{
  position:relative;
  overflow:hidden;
  border-radius:36px;
  padding:42px 38px;
  box-shadow:
    0 18px 50px rgba(15,23,42,.10),
    inset 0 1px 0 rgba(255,255,255,.08);
}

/* VERMELHO */
.abnt-card-red{
  background:
    linear-gradient(135deg,#8f1111 0%,#c51616 100%);
}

/* VERDE */
.abnt-card-green{
  background:
    linear-gradient(135deg,#0d5a35 0%,#199754 100%);
}

/* OVERLAY */
.abnt-campanha-card:before{
  content:"";
  position:absolute;
  top:-140px;
  right:-120px;
  width:360px;
  height:360px;
  border-radius:50%;
  background:rgba(255,255,255,.08);
}

.abnt-campanha-card:after{
  content:"";
  position:absolute;
  bottom:-180px;
  left:-140px;
  width:360px;
  height:360px;
  border-radius:50%;
  background:rgba(255,255,255,.05);
}

/* HEADER */
.abnt-campanha-kicker{
  position:relative;
  z-index:2;
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:11px 18px;
  border-radius:999px;
  background:rgba(255,255,255,.10);
  border:1px solid rgba(255,255,255,.14);
  backdrop-filter:blur(10px);
  color:#fff;
  font-size:12px;
  font-weight:900;
  letter-spacing:.06em;
  text-transform:uppercase;
  margin-bottom:24px;
}

/* ICONE GOTA */
.abnt-drop-icon{
  width:15px;
  height:15px;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-shrink:0;
}

.abnt-drop-icon svg{
  width:15px;
  height:15px;
  display:block;
}

.abnt-drop-icon svg path{
  fill:#ffd8d8;
}

/* TITULOS */
.abnt-campanha-title{
  position:relative;
  z-index:2;
  margin:0 0 18px;
  font-family:Manrope,Inter,sans-serif;
  font-size:42px;
  line-height:1.05;
  font-weight:900;
  text-transform:uppercase;
}

.abnt-card-red .abnt-campanha-title{
  color:#ffe3e3;
}

.abnt-card-green .abnt-campanha-title{
  color:#ddffea;
}

.abnt-campanha-desc{
  position:relative;
  z-index:2;
  color:rgba(255,255,255,.84);
  font-size:16px;
  line-height:1.8;
  margin-bottom:34px;
  max-width:95%;
}

/* GRID */
.abnt-normas-grid{
  position:relative;
  z-index:2;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px;
}

/* ITEM */
.abnt-norma-item{
  background:rgba(255,255,255,.10);
  border:1px solid rgba(255,255,255,.12);
  backdrop-filter:blur(14px);
  border-radius:24px;
  padding:22px 20px;
  display:flex;
  flex-direction:column;
  transition:.25s ease;
}

.abnt-norma-item:hover{
  transform:translateY(-3px);
  background:rgba(255,255,255,.13);
}

/* TITULO */
.abnt-norma-item h3{
  margin:0 0 14px;
  font-family:Manrope,Inter,sans-serif;
  font-size:16px;
  line-height:1.35;
  font-weight:900;
}

.abnt-card-red .abnt-norma-item h3{
  color:#ffe7e7;
}

.abnt-card-green .abnt-norma-item h3{
  color:#e2ffed;
}

/* TEXTO */
.abnt-norma-item p{
  margin:0 0 18px;
  color:rgba(255,255,255,.82);
  font-size:14px;
  line-height:1.75;
  flex-grow:1;
}

/* BOTÕES */
.abnt-norma-btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:max-content;
  min-width:112px;
  padding:11px 18px;
  border-radius:999px;
  text-decoration:none!important;
  font-size:11px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.08em;
  transition:.25s ease;
  backdrop-filter:blur(10px);
}

.abnt-card-red .abnt-norma-btn{
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.18);
  color:#fff7f7!important;
}

.abnt-card-green .abnt-norma-btn{
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.18);
  color:#f1fff7!important;
}

.abnt-norma-btn:hover{
  transform:translateY(-2px);
  background:rgba(255,255,255,.18);
}

/* RESPONSIVO */
@media(max-width:1200px){

  .abnt-campanhas-wrap{
    grid-template-columns:1fr;
  }

}

@media(max-width:900px){

  .abnt-normas-grid{
    grid-template-columns:1fr;
  }

}

@media(max-width:767px){

  .abnt-campanhas-section{
    padding:44px 18px;
  }

  .abnt-campanha-card{
    padding:30px 22px;
    border-radius:28px;
  }

  .abnt-campanha-title{
    font-size:30px;
  }

  .abnt-campanha-desc{
    font-size:15px;
  }

  .abnt-norma-item{
    padding:20px;
  }

  .abnt-norma-btn{
    width:100%;
  }

}
</style>

