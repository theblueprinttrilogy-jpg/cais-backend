  font-size:14px;font-weight:800;color:#003F7D;
}

.abnt-news-wrap{
  padding:34px 0 52px;
}

.abnt-news-grid{
  display:grid;
  grid-template-columns:1.45fr 1fr;
  gap:26px;
}

/* CARD */
.news-card{
  background:#fff;
  border:1px solid rgba(0,63,125,.10);
  border-radius:20px;
  overflow:hidden;
  height:100%;
  box-shadow:0 16px 38px rgba(14,45,85,.08);
  transition:.25s ease;
}

.news-card:hover{
  transform:translateY(-3px);
  box-shadow:0 22px 48px rgba(14,45,85,.14);
  border-color:rgba(246,188,0,.45);
}

/* IMAGENS */
.news-image{
  display:block;
  position:relative;
  overflow:hidden;
  background:#eef3f8;
}

.news-image div{
  position:absolute;
  inset:0;
  background-size:cover;
  background-position:center;
  transition:transform .45s ease;
}

.news-card:hover .news-image div{
  transform:scale(1.045);
}

.news-main .news-image{
  padding-top:56.25%;
}

.news-side .news-image{
  width:132px;
  min-width:132px;
  height:96px;
  border-radius:14px;
}

/* CONTEÚDO */
.news-content{
  padding:26px;
}

.news-side-inner{
  display:flex;
  gap:16px;
  align-items:center;
  padding:15px;
}

.news-kicker{
  display:inline-flex;
  align-items:center;
  gap:7px;
  margin-bottom:12px;
  font-family:Manrope,Inter,Arial,sans-serif;
  font-size:11px;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:#003F7D;
}

.news-kicker:before{
  content:"";
  width:7px;
  height:7px;
  border-radius:50%;
  background:#F6BC00;
}

.news-title{
  font-family:Manrope,Inter,Arial,sans-serif;
  color:#003F7D;
  margin:0;
  font-weight:850;
  letter-spacing:-.025em;
}

.news-main-title{
  font-size:28px;
  line-height:1.16;
  max-width:760px;
}

.news-side-title{
  font-size:15.5px;
  line-height:1.28;
  display:-webkit-box;
  -webkit-line-clamp:3;
  -webkit-box-orient:vertical;
  overflow:hidden;
}

.news-date{
  margin-top:10px;
  font-family:Inter,Arial,sans-serif;
  font-size:12px;
  color:#667085;
}

/* BOTÃO */
.btn-leia{
  margin-top:22px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:8px;
  background:#003F7D;
  color:#fff!important;
  border-radius:999px;
  padding:13px 24px;
  font-family:Manrope,Inter,Arial,sans-serif;
  font-size:13px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.04em;
  text-decoration:none!important;
  transition:.22s ease;
}

.btn-leia:after{
  content:"→";
  font-size:15px;
  transition:.22s ease;
}

.btn-leia:hover{
  background:#002F5F;
