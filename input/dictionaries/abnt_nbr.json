.abnt-topbar{
  width:100%;
  position:relative;
  overflow:hidden;
  background:
    linear-gradient(90deg,
      #8f1111 0%,
      #b91c1c 48%,
      #0f5a38 52%,
      #198754 100%);
  display:flex;
  align-items:center;
  justify-content:center;
  min-height:54px;
  font-family:Manrope,Inter,Arial,sans-serif;
  color:#fff;
  box-shadow:
    0 8px 26px rgba(0,0,0,.12),
    inset 0 -1px 0 rgba(255,255,255,.08);
}

/* EFEITOS */
.abnt-topbar:before{
  content:"";
  position:absolute;
  top:-120px;
  left:-80px;
  width:240px;
  height:240px;
  border-radius:50%;
  background:rgba(255,255,255,.05);
}

.abnt-topbar:after{
  content:"";
  position:absolute;
  bottom:-140px;
  right:-90px;
  width:260px;
  height:260px;
  border-radius:50%;
  background:rgba(255,255,255,.05);
}

.abnt-topbar-inner{
  position:relative;
  z-index:2;
  width:100%;
  max-width:1320px;
  display:grid;
  grid-template-columns:1fr 1fr;
  align-items:center;
  gap:20px;
  padding:10px 24px;
}

/* COLUNAS */
.abnt-topbar-side{
  display:flex;
  align-items:center;
  gap:14px;
}

.abnt-topbar-side.right{
  justify-content:flex-end;
  text-align:right;
}

/* DIVISOR */
.abnt-topbar-divider{
  position:absolute;
  left:50%;
  top:50%;
  transform:translate(-50%,-50%);
  width:1px;
  height:34px;
  background:rgba(255,255,255,.18);
}

/* ICONES */
.abnt-ribbon{
  width:38px;
  height:38px;
  border-radius:50%;
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.16);
  display:flex;
  align-items:center;
  justify-content:center;
  backdrop-filter:blur(10px);
  flex-shrink:0;
}

/* SVG */
.abnt-ribbon svg{
  width:18px;
  height:18px;
  display:block;
}

.abnt-ribbon svg *{
  fill:currentColor;
  stroke:currentColor;
}

/* TEXTOS */
.abnt-topbar-badge{
  display:block;
  font-size:11px;
  font-weight:900;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:rgba(255,255,255,.72);
  margin-bottom:2px;
}

.abnt-topbar-title{
  font-size:16px;
  font-weight:900;
  line-height:1.2;
  color:#fff;
}

.abnt-topbar-text{
  font-size:13px;
  color:rgba(255,255,255,.84);
  line-height:1.4;
  margin-top:2px;
}

/* RESPONSIVO */
@media(max-width:768px){

  .abnt-topbar-inner{
    grid-template-columns:1fr;
    gap:0;
    padding:0;
  }

  .abnt-topbar-side{
    padding:14px 18px;
  }

  .abnt-topbar-side.right{
    justify-content:flex-start;
    text-align:left;
    border-top:1px solid rgba(255,255,255,.12);
  }

  .abnt-topbar-divider{
    display:none;
  }

  .abnt-topbar-title{
    font-size:15px;
  }

  .abnt-topbar-text{
    font-size:12px;
  }

}
</style>

<div class="abnt-topbar">

  <div class="abnt-topbar-inner">

    <!-- JUNHO VERMELHO -->
    <div class="abnt-topbar-side">

      <!-- GOTA DE SANGUE -->
      <span class="abnt-ribbon">

        <svg viewBox="0 0 24 24">
          <path d="
            M12 2
            C12 2 5 10 5 14.5
            C5 18.64 8.36 22 12.5 22
            C16.64 22 20 18.64 20 14.5
            C20 10 12 2 12 2Z
          "/>
        </svg>

      </span>

      <div>

        <div class="abnt-topbar-title">
          Junho Vermelho
        </div>

        <div class="abnt-topbar-text">
          Qualidade e segurança na saúde.
