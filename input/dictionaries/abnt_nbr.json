<div class="container abnt-news-wrap">
  <div id="eventos" class="abnt-news-grid"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

<script>
function ajustarData(dataInput) {
  const d = new Date(dataInput);
  return ("0" + d.getUTCDate()).slice(-2) + "/" +
         ("0" + (d.getUTCMonth() + 1)).slice(-2) + "/" +
         d.getUTCFullYear();
}

function slugify(texto) {
  return texto
    .toString()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\w\s-]/g, "")
    .trim()
    .replace(/\s+/g, "-")
    .toLowerCase();
}

function GetEeventos(qtd, pagina) {
  axios.get("https://admabnt.com.br/backend/api/v1/newsletter/5/2", {
    params: {
      page: pagina * qtd,
      page_size: qtd,
      sortBy: "date",
      sortDesc: true
    }
  }).then(res => {
    const eventos = res.data.data;
    $("#eventos").html("");

    if (!eventos.length) {
      $("#loading").hide();
      return;
    }

    const p = eventos[0];

    $("#eventos").append(`
      <article class="news-card news-main">
        <a class="news-image" target="_blank" href="./noticia/${p.id}/${slugify(p.title)}" aria-label="${p.title}">
          <div style="background-image:url('${p.image_url}')"></div>
        </a>

        <div class="news-content">
          <div class="news-kicker">Notícia em destaque</div>
          <h3 class="news-title news-main-title">${p.title}</h3>
          <div class="news-date">${ajustarData(p.created_at)}</div>

          <a class="btn-leia" target="_blank" href="./noticia/${p.id}/${slugify(p.title)}">
            Leia mais
          </a>
        </div>
      </article>

      <div class="news-side-list" id="laterais"></div>
    `);

    eventos.slice(1, 5).forEach(e => {
      $("#laterais").append(`
        <article class="news-card news-side">
          <div class="news-side-inner">
            <a class="news-image" target="_blank" href="./noticia/${e.id}/${slugify(e.title)}" aria-label="${e.title}">
              <div style="background-image:url('${e.image_url}')"></div>
            </a>

            <div class="news-text">
              <div class="news-kicker">Notícia</div>
              <h4 class="news-title news-side-title">${e.title}</h4>
              <div class="news-date">${ajustarData(e.created_at)}</div>

              <a class="link-leia" target="_blank" href="./noticia/${e.id}/${slugify(e.title)}">
                Leia mais
              </a>
            </div>
          </div>
        </article>
      `);
    });

    $("#loading").hide();
  }).catch(err => {
    console.error("Erro ao carregar notícias:", err);
    $("#loading").hide();
  });
}

GetEeventos(5, 0);
</script>				</div>
