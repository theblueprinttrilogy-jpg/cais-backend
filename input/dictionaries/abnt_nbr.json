<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

<script>
(function() {

  function iniciarCarrossel() {

    const container = document.getElementById('carrocelBase');
    if (!container) return;

    axios.get('https://admabnt.com.br/backend/api/v1/banners/5/2')

      .then(response => {

        if (!response.data || response.data.length === 0) {
          console.log('Nenhum banner encontrado');
          return;
        }

        let indicadores = '';
        let slides = '';

        response.data.forEach((item, index) => {

          const ativo = index === 0 ? 'active' : '';

          indicadores += `
            <button type="button"
              data-bs-target="#carousel"
              data-bs-slide-to="${index}"
              class="${ativo}"
              aria-label="Slide ${index + 1}">
            </button>
          `;

          slides += `
            <div class="carousel-item ${ativo}">

              <div style="background-image:url('${item.image_link}');
                          width:100%;
                          height:100%;
                          background-position:center center;
                          background-size:cover;
                          background-repeat:no-repeat;">
              </div>

              <div class="carousel-content">
                <h1>${item.title}</h1>
                ${item.subtitle ? `<h5>${item.subtitle}</h5>` : ''}
                <a href="${item.banner_link}" target="_blank" rel="noopener noreferrer" class="btn-saiba-mais">
                  SAIBA MAIS
                </a>
              </div>

            </div>
          `;
        });

        const carrosselHTML = `

          <div id="carousel" class="carousel slide">

            <div class="carousel-indicators">
              ${indicadores}
            </div>

            <div class="carousel-inner">
              ${slides}
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#carousel" data-bs-slide="prev">
              <span class="carousel-control-prev-icon"></span>
              <span class="visually-hidden">Anterior</span>
            </button>

            <button class="carousel-control-next" type="button" data-bs-target="#carousel" data-bs-slide="next">
              <span class="carousel-control-next-icon"></span>
              <span class="visually-hidden">Próximo</span>
            </button>

          </div>
        `;

        container.innerHTML = carrosselHTML;

        const carouselElement = document.getElementById('carousel');

        if (carouselElement && typeof bootstrap !== 'undefined') {

          new bootstrap.Carousel(carouselElement, {
            interval: 3000,
            ride: 'carousel',
            pause: 'hover',
            wrap: true
          });

        }

      })
      .catch(error => {
        console.error('Erro ao carregar banners:', error);
      });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciarCarrossel);
  } else {
    setTimeout(iniciarCarrossel, 300);
  }

})();
</script>				</div>
