<script>






(function($) {
    "use strict";

	jQuery(document).ready(function($) {

		var selector_history = {};

		//Selector clicked
		$('.cype_selector_button .elementor-button, a.cype_selector_button, a.cype_selector').on('click', function(e) {
			cype_selector_button_clicked ($(this), e);
		});


		//Trigger the selectors activated on page load
		var initialized_groups = [];
		$('.cype_selector_button.cype_selector_button_activated').each(function() {
            var selector_name = $(this).data('cype-selector-name');

			//Only 1 execution for group
            if (selector_name && !initialized_groups.includes(selector_name)) {
                initialized_groups.push(selector_name);
                const $trigger = $(this).find('.elementor-button').length ? $(this).find('.elementor-button') : $(this);
				const e = null;
                cype_selector_button_clicked ($trigger, e);
            }
        });


		
		function cype_selector_button_clicked ($element_clicked, e) {

			
			var click_executed = false;

			if (e && typeof e.preventDefault === 'function') {
				e.preventDefault();
				click_executed = true;
			}


			//Retrieving data


			//For .cype_selector_button .elementor-button
			const $selector_button_clicked_original = $element_clicked.closest('.cype_selector_button');

			//Checking if it's the case: a.cype_selector_button 
			const $selector_button_clicked = $selector_button_clicked_original.length ? $selector_button_clicked_original : $element_clicked;


			const selector_name = $selector_button_clicked.data('cype-selector-name');
			const selector_option = $selector_button_clicked.data('cype-selector-option');


			if (!selector_name || !selector_option) {
				console.log("CYPE error: missing data on selector");
				return;
			}




			//Min and max
			var selector_buttons_activated_min = parseInt($selector_button_clicked.data('cype-selector-buttons-activated-min'), 10);

			if (isNaN(selector_buttons_activated_min) || selector_buttons_activated_min < 1) {
				selector_buttons_activated_min = 1;
			}


			var selector_buttons_activated_max = parseInt($selector_button_clicked.data('cype-selector-buttons-activated-max'), 10);

			if ((isNaN(selector_buttons_activated_max) || selector_buttons_activated_max < 1)
				&& 1 == selector_buttons_activated_min) {
				//1 Button max
				selector_buttons_activated_max = 1;
			}
			else if (isNaN(selector_buttons_activated_max) || selector_buttons_activated_max < 1) {
				//Al buttons allowed
				selector_buttons_activated_max = $('.cype_selector_button[data-cype-selector-name="' + selector_name + '"]').length;
			}


			if (selector_buttons_activated_max < selector_buttons_activated_min) {
				selector_buttons_activated_max = selector_buttons_activated_min;
			}


			

			var cype_selector_container_update_do = false;


			//Historical click order and buttons logic


			var selector_button_clicked_initially_activated = $selector_button_clicked.hasClass("cype_selector_button_activated");
			
			if (	1 == selector_buttons_activated_min
				&& 	1 == selector_buttons_activated_max) {
				//1 option, use simple logic
				//The button can't be deactivated

				if (!selector_button_clicked_initially_activated || !click_executed) {
					$('.cype_selector_button[data-cype-selector-name="' + selector_name + '"]').removeClass("cype_selector_button_activated");
					$selector_button_clicked.addClass("cype_selector_button_activated");
					cype_selector_container_update_do = true;
				}

			}
			else {
				//Multiple options

				if (!selector_history[selector_name]) {
					selector_history[selector_name] = [];

					//Page load

					//The selector_history priority is in reverse, that's why the DOM is read in reverse

					//Buttons not activated, low priority in historial
					//$('.cype_selector_button[data-cype-selector-name="' + selector_name + '"]').not('.cype_selector_button_activated').each(function() {
					$($('.cype_selector_button[data-cype-selector-name="' + selector_name + '"]').not('.cype_selector_button_activated').get().reverse()).each(function() {
						var opt = $(this).data('cype-selector-option');
						if (opt && !selector_history[selector_name].includes(opt)) {
							selector_history[selector_name].push(opt);
						}
					});

					//Activated buttons, high priority in historial
					//$('.cype_selector_button.cype_selector_button_activated[data-cype-selector-name="' + selector_name + '"]').each(function() {
					$($('.cype_selector_button.cype_selector_button_activated[data-cype-selector-name="' + selector_name + '"]').get().reverse()).each(function() {
						var opt = $(this).data('cype-selector-option');
						if (opt && !selector_history[selector_name].includes(opt)) {
							selector_history[selector_name].push(opt);
						}
					});
				}


				if (click_executed) {
					//Reorder array

					selector_history[selector_name] = selector_history[selector_name].filter(item => item !== selector_option);

					if (selector_button_clicked_initially_activated) {
						//Deactivating button
						selector_history[selector_name].unshift(selector_option);
						$selector_button_clicked.removeClass("cype_selector_button_activated");
					} else {
						//Activating button
						selector_history[selector_name].push(selector_option);
						$selector_button_clicked.addClass("cype_selector_button_activated");
					}
					cype_selector_container_update_do = true;
				}
				else {
					$selector_button_clicked.addClass("cype_selector_button_activated");
					cype_selector_container_update_do = true;
				}


				
				//Max control
				var selector_history_count = selector_history[selector_name].length;
				var selector_buttons_activated_count = $('.cype_selector_button.cype_selector_button_activated[data-cype-selector-name="' + selector_name + '"]').length;

				if (selector_buttons_activated_count > selector_buttons_activated_max) {

					//Deactivating the first array items
					for (var i = 0; i < selector_history_count; i++) {
						var opt_to_deactivate = selector_history[selector_name][i];
						var $btn_to_deactivate = $('.cype_selector_button[data-cype-selector-name="' + selector_name + '"][data-cype-selector-option="' + opt_to_deactivate + '"]');

						if ($btn_to_deactivate.hasClass('cype_selector_button_activated')) {

							var opt = $btn_to_deactivate.data('cype-selector-option');
							selector_history[selector_name] = selector_history[selector_name].filter(item => item !== opt);
							selector_history[selector_name].push(opt);

							$btn_to_deactivate.removeClass('cype_selector_button_activated');
							cype_selector_container_update_do = true;
							selector_buttons_activated_count --;
						}

						if (selector_buttons_activated_count <= selector_buttons_activated_max) {
							break;
						}
					}
				}


				//Min control
				if (selector_buttons_activated_count < selector_buttons_activated_min) {

					for (var i = selector_history_count - 1; i >= 0; i--) {
						var opt_to_rescue = selector_history[selector_name][i];
						var $btn_to_rescue = $('.cype_selector_button[data-cype-selector-name="' + selector_name + '"][data-cype-selector-option="' + opt_to_rescue + '"]');

						if (!$btn_to_rescue.hasClass('cype_selector_button_activated')) {

							var opt = $btn_to_rescue.data('cype-selector-option');
							selector_history[selector_name] = selector_history[selector_name].filter(item => item !== opt);
							selector_history[selector_name].push(opt);

							$btn_to_rescue.addClass('cype_selector_button_activated');
							cype_selector_container_update_do = true;
							selector_buttons_activated_count++;
						}

						if (selector_buttons_activated_count >= selector_buttons_activated_min) {
							break;
						}
					}
				}
            }
					

			//Cointainer logic
            if (cype_selector_container_update_do) {
                $('.cype_selector_container[data-cype-selector-name="' + selector_name + '"]').hide().removeClass('cype_selector_container_activated');

                $('.cype_selector_button.cype_selector_button_activated[data-cype-selector-name="' + selector_name + '"]').each(function() {
                    var selector_option_activated = $(this).data('cype-selector-option');
                    $('.cype_selector_container[data-cype-selector-name="' + selector_name + '"][data-cype-selector-option="' + selector_option_activated + '"]').fadeIn(300).addClass('cype_selector_container_activated');
                });
            }
		} 






		

		//Selector clicked
		$('.cype_selector_button_stand_alone .elementor-button, a.cype_selector_button_stand_alone, a.cype_selector').on('click', function(e) {
			cype_selector_button_stand_alone_clicked ($(this), e);
		});


		//Trigger the selectors activated on page load
		var initialized_groups = [];
		$('.cype_selector_button_stand_alone').each(function() {
            var selector_name = $(this).data('cype-selector-name');

			//Only 1 execution for group
            if (selector_name && !initialized_groups.includes(selector_name)) {
                initialized_groups.push(selector_name);
                const $trigger = $(this).find('.elementor-button').length ? $(this).find('.elementor-button') : $(this);
				const e = null;
				const page_load = true;
                cype_selector_button_stand_alone_clicked ($trigger, e, page_load);
            }
        });


		
		function cype_selector_button_stand_alone_clicked ($element_clicked, e, page_load = false) {
			if (e && typeof e.preventDefault === 'function') {
				e.preventDefault();
			}



			//Retrieving data


			//For .cype_selector_button .elementor-button
			const $selector_button_clicked_original = $element_clicked.closest('.cype_selector_button_stand_alone');

			//Checking if it's the case: a.cype_selector_button 
			const $selector_button_clicked = $selector_button_clicked_original.length ? $selector_button_clicked_original : $element_clicked;


			const selector_name = $selector_button_clicked.data('cype-selector-name');
			const selector_options_string = $selector_button_clicked.data('cype-selector-options');


			if (!selector_name || !selector_options_string) {
				console.log("CYPE error: missing data on selector");
				return;
			}



			const selector_options = selector_options_string.split(",");

			if (typeof selector_options[1] === "undefined") {
				console.log("CYPE error: missing data on selector");
				return;
			}




			//Basic logic
			var selector_button_clicked_activated_option_number_initially = 1;
			var selector_button_clicked_activated_option_number_future = 2;
			var selector_option_selected_future = selector_options[1];

			if ((	true == $selector_button_clicked.hasClass("cype_selector_button_stand_alone_activated_option_2")
					&&	!page_load
				)
				|| 
				(		true == $selector_button_clicked.hasClass("cype_selector_button_stand_alone_activated_option_1")
					&&	page_load)
				) {
				selector_button_clicked_activated_option_number_initially = 2;
				selector_button_clicked_activated_option_number_future = 1;
				selector_option_selected_future = selector_options[0];
			}

			
			console.log(selector_button_clicked_activated_option_number_initially);
			console.log(selector_button_clicked_activated_option_number_future);


			//Button logic
			$selector_button_clicked.addClass("cype_selector_button_stand_alone_activated_option_" + selector_button_clicked_activated_option_number_future);
			$selector_button_clicked.removeClass("cype_selector_button_stand_alone_activated_option_" + selector_button_clicked_activated_option_number_initially);
			$selector_button_clicked.attr('data-cype-selector-option', selector_option_selected_future);



			//Label logic
			$('.cype_selector_label[data-cype-selector-name="' + selector_name + '"]').removeClass('cype_selector_label_activated');
			$('.cype_selector_label[data-cype-selector-name="' + selector_name + '"][data-cype-selector-option="' + selector_option_selected_future + '"]').addClass('cype_selector_label_activated');



			//Containers logic
			if (!page_load) {
				$('.cype_selector_container[data-cype-selector-name="' + selector_name + '"]').hide();
				$('.cype_selector_container[data-cype-selector-name="' + selector_name + '"][data-cype-selector-option="' + selector_option_selected_future + '"]').fadeIn(300);
			}
			else {
				$('.cype_selector_container[data-cype-selector-name="' + selector_name + '"]').hide();
				$('.cype_selector_container[data-cype-selector-name="' + selector_name + '"][data-cype-selector-option="' + selector_option_selected_future + '"]').show();
			}
			


		}

	});


})(jQuery);</script>


