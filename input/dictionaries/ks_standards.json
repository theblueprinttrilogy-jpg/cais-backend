<script>
$(function(){
	var size=16;
	var body=$("body");

	$(".zoom a").on("click",function(){
		var btn_index=$(".zoom a").index(this);
		if(btn_index==1){//+
	    	size++;
	        body.css("font-size",size+"px");
		}else if(btn_index==2){//-
			size--;
	        body.css("font-size",size+"px");
	    }else{
	   		size=12;//디폴트
	        body.css("font-size","12px");
	  	}
		//$("#lbl_fontsize").text(size);
	});
});

