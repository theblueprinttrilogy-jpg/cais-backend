		$("#best" + type).css("display","inline-block");
	}

	//팝업을 위한 쿠키 셋업
	var setCookie = function(id){
		var today = new Date();
		today.setDate(today.getDate() +1)
		var exp = new Date(today - today % (24 * 60 * 60 * 1000));
		document.cookie = id + '=' + id + ';expires=' + exp.toUTCString() + ';';
	}

	//---- 팝업 생성 ----
	function createPopup(id, title, width, height, index) {
		if (getCookie('popup' + id)) return;

		const popup = document.createElement("div");
		popup.className = "notice-popup";

		let prevWidth = 0;
		if(index > 0) {
			for(let i = 0; i < index; i++) {
				prevWidth += $(".notice-popup").eq(i).width() + 16;
			}
		}

		const leftPos = 16 + prevWidth; // left 기준 배치
		popup.style.left = leftPos + 'px';
		popup.style.width = width + 'px';

		popupContents = '';
		popupContents += '<div class="popup-header">';
		popupContents += '  <h3 class="popup-title">'+title+'</h3>';
		popupContents += '  <button class="popup-close" aria-label="닫기">';
		popupContents += '    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"';
		popupContents += '          xmlns="http://www.w3.org/2000/svg">';
		popupContents += '      <path d="M6 6L18 18M6 18L18 6" stroke="white"';
		popupContents += '            stroke-width="2" stroke-linecap="round"/>';
		popupContents += '    </svg>';
		popupContents += '  </button>';
		popupContents += '</div>';
		popupContents += '<div class="popup-body">';
		popupContents += '</div>';
		popupContents += '<div class="popup-footer">';
		popupContents += '  <label>';
		popupContents += '    <input type="checkbox" class="dont-show-today" name="hidePopup_'+ id +'"/>';
		popupContents += '    오늘 하루 보지 않기';
		popupContents += '  </label>';
		popupContents += '</div>';

		popup.innerHTML = popupContents;

		popup.querySelector(".popup-close").addEventListener("click", () => popup.remove());
		popup.querySelector(".dont-show-today").addEventListener("change", (e) => {
			setCookie('popup' + id);
		    popup.remove();
		});

		let url = "/mainPopup.do";
		let data = {
			"popupId" : id
		};
		$(".popup-body", popup).load(url, data, function(req, status, xhr){
			if(height > 0) {
				$(".popup-body img", popup).css("height", height + "px");
			}
		});

		document.body.appendChild(popup);
	}

	
</script>

